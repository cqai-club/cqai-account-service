PORT=8787

# Logto API Resource settings. The issuer normally ends in /oidc.
LOGTO_ISSUER=https://auth.cqaiclub.asia/oidc
LOGTO_AUDIENCE=https://account.cqaiclub.asia
# LOGTO_JWKS_URI defaults to ${LOGTO_ISSUER}/jwks.
# LOGTO_REQUIRED_SCOPES defaults to ai:invoke and can be changed from /admin/.

# Optional bootstrap values. Leave empty to configure these from a same-origin
# /admin/ page after startup; empty values fail closed for cross-origin calls
# and customer APIs.
# CORS_ALLOWED_ORIGINS=
# LOGTO_CLIENT_PLATFORM_MAP={}

# Logto SPA client used by the /admin/ login button. Access is granted by the
# config:read/config:write scopes in the verified Access Token.
LOGTO_ADMIN_CLIENT_ID=replace-with-admin-client-id
LOGTO_ADMIN_REDIRECT_URI=https://account-admin.example.com/

# NewAPI service token is server-only; provide it through the environment or a
# Secret Manager. It is never returned by the admin API. Leave it empty only
# when starting the admin UI before NewAPI is configured.
# NEW_API_BASE_URL=https://ai.cqaiclub.asia
# NEW_API_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Runtime settings can be changed from /admin/ after the admin Logto client is
# configured. These defaults are used when the variables are omitted.
# ACCOUNT_CACHE_TTL_SECONDS=300
# MAX_REQUEST_BODY_BYTES=20971520

# Optional JSON persistence for the safe, dynamically editable fields only.
# Leave empty for in-memory runtime configuration.
# CONFIG_STORE_PATH=/secure/path/runtime-config.json

# Optional path to the built admin UI directory. Defaults to ../../admin/dist
# relative to the server build; only point this at the reviewed admin bundle.
# ADMIN_UI_DIR=/path/to/apps/admin/dist
