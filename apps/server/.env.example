PORT=8787

# Temporarily enable secret-free authentication and provisioning diagnostics.
# Keep this disabled in production unless actively investigating a request.
DEBUG_AUTH_LOGS=0

# Logto API Resource settings. The issuer normally ends in /oidc.
LOGTO_ISSUER=https://auth.cqaiclub.asia/oidc
LOGTO_AUDIENCE=https://account.cqaiclub.asia
# LOGTO_JWKS_URI defaults to ${LOGTO_ISSUER}/jwks.
# LOGTO_REQUIRED_SCOPES defaults to ai:invoke.
# A scope carrying the Logto role grants the NewAPI role at provisioning:
# admin scope -> NewAPI role 10, root scope -> NewAPI role 100. Tokens
# without either scope provision a regular (non-elevated) NewAPI user.
# LOGTO_ADMIN_SCOPE=account:admin
# LOGTO_ROOT_SCOPE=account:root

# Browser origins allowed to call /api/account, /v1/* and the web payment
# callback selector. Every web redirect origin below must be listed here.
# Production values come from GitHub variables.
CORS_ALLOWED_ORIGINS=https://cqai-club.github.io,http://127.0.0.1:3003,http://localhost:3003

# Default model name returned by /api/client-credential for trusted clients that
# cannot ask the user for a model. Empty means the client picks its own.
# CLIENT_DEFAULT_MODEL=gpt-4o-mini

# JSON object mapping verified Logto client IDs to platform, client type and
# server-selected payment redirects. Web redirects are keyed by exact Origin;
# desktop redirects use a fixed custom protocol and do not need Origin.
# Production values come from GitHub variables.
LOGTO_CLIENT_PLATFORM_MAP={"web-client-id":{"platform":"lingweave","client_type":"web","redirects":{"https://cqai-club.github.io":{"success_url":"https://cqai-club.github.io/lingweave/billing/result","cancel_url":"https://cqai-club.github.io/lingweave/billing/result?status=cancelled"},"http://127.0.0.1:3003":{"success_url":"http://127.0.0.1:3003/billing/result","cancel_url":"http://127.0.0.1:3003/billing/result?status=cancelled"},"http://localhost:3003":{"success_url":"http://localhost:3003/billing/result","cancel_url":"http://localhost:3003/billing/result?status=cancelled"}}},"desktop-client-id":{"platform":"cqai-desktop","client_type":"desktop","redirects":{"success_url":"cqai://payment/result","cancel_url":"cqai://payment/result?status=cancelled"}}}

# NewAPI provisioning endpoint and server-only service token. These must not
# be exposed to browsers, logs, variables, or plaintext cache storage.
NEW_API_BASE_URL=https://relay.cqaiclub.asia
NEW_API_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Optional Redis URL. When omitted, process memory is used. When set, cached
# NewAPI keys are encrypted before being written to Redis.
# REDIS_URL=redis://:password@127.0.0.1:6380/0

# ACCOUNT_CACHE_TTL_SECONDS=300
# MAX_REQUEST_BODY_BYTES=20971520
